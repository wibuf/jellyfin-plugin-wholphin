<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fork: tests for the personal home rows' selection rules (GooseFlix #1635). They compile the
       pure selection files directly, so they run without Jellyfin's runtime assemblies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Jellyfin.Plugin.Wholphin\Rows\RowSelection.cs" Link="Rows\RowSelection.cs" />
    <Compile Include="..\Jellyfin.Plugin.Wholphin\Rows\RowsConfig.cs" Link="Rows\RowsConfig.cs" />
    <Compile Include="..\Jellyfin.Plugin.Wholphin\Ratings\RatingsQueue.cs" Link="Ratings\RatingsQueue.cs" />
    <Compile Include="..\Jellyfin.Plugin.Wholphin\Ratings\TitleRatingsLogic.cs" Link="Ratings\TitleRatingsLogic.cs" />
    <Compile Include="..\Jellyfin.Plugin.Wholphin\Ratings\TitleRatingsConfig.cs" Link="Ratings\TitleRatingsConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
